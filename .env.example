# Required — copy to .env and fill in your real values

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# FastAPI
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_random_secret
APP_CORS_ORIGINS=http://localhost:3000
APP_FRONTEND_URL=http://localhost:3000

# Email Service (SMTP / Gmail or Resend)
EMAIL_PROVIDER=smtp
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
EMAIL_FROM=AI Job-Fit Assessment <your_gmail_address@gmail.com>

# Optional overrides
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.3
